{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "StoreMind": {
    "StoreId": "store-001",
    "VectorStore": {
      "Provider": "InMemory",
      "QdrantEndpoint": "http://localhost:6333",
      "CollectionName": "inventory"
    },
    "Persistence": {
      "BasePath": "./data",
      "PlansPath": "./data/plans",
      "LogsPath": "./logs"
    },
    "Orchestration": {
      "MaxIterations": 3,
      "MaxToolCalls": 10,
      "TimeoutSeconds": 60
    },
    "Models": {
      "EdgeModelPath": "./models/phi3-mini-onnx",
      "PlannerModel": "claude-opus-4.5",
      "CriticModel": "gpt-5.2"
    }
  }
}
