{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "StoreMind": {
    "StoreId": "store-001",
    "VectorStore": {
      "Provider": "InMemory",
      "QdrantEndpoint": "http://localhost:6333",
      "CollectionName": "inventory"
    },
    "Persistence": {
      "BasePath": "./data",
      "PlansPath": "./data/plans",
      "LogsPath": "./logs"
    },
    "Orchestration": {
      "MaxIterations": 3,
      "MaxToolCalls": 10,
      "TimeoutSeconds": 60
    },
    "Models": {
      "// PROVIDER CONFIGURATIONS": "API keys are loaded from .env file or environment variables",
      
      "Groq": {
        "ApiKey": "",
        "Endpoint": "https://api.groq.com/openai/v1",
        "Enabled": true
      },
      
      "GitHubModels": {
        "ApiKey": "",
        "Endpoint": "https://models.github.ai/inference",
        "Enabled": true
      },
      
      "OpenRouter": {
        "ApiKey": "",
        "Endpoint": "https://openrouter.ai/api/v1",
        "Enabled": true
      },
      
      "GoogleAI": {
        "ApiKey": "",
        "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai",
        "Enabled": true
      },
      
      "OpenAI": {
        "ApiKey": "",
        "Endpoint": "https://api.openai.com/v1",
        "Enabled": false
      },

      "// AGENT ROLE ASSIGNMENTS": "Map each agent role to a model + provider",
      
      "Router": {
        "ModelId": "llama-3.3-70b-versatile",
        "Provider": "Groq"
      },
      
      "ContextWorker": {
        "ModelId": "gemini-2.5-flash-lite",
        "Provider": "GoogleAI"
      },
      
      "Reasoner": {
        "ModelId": "deepseek/deepseek-r1",
        "Provider": "OpenRouter"
      },
      
      "Judge": {
        "ModelId": "openai/o3",
        "Provider": "GitHubModels"
      },
      
      "Specialist": {
        "ModelId": "llama-3.3-70b-versatile",
        "Provider": "Groq"
      }
    }
  }
}
